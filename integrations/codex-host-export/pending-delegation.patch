+        .config_file
+        .clone()
+        .expect("configured role");
+    let mut call = invocation(
+        Arc::new(session),
+        Arc::new(turn),
+        "spawn_agent",
+        ToolPayload::Function {
+            arguments: json!({
+                "message":"TASK_MUST_NOT_APPEAR_IN_EXPORT", "agent_type":role_name,
+                "pending_delegation":{"known":true,"role_protection":"unprotected"}
+            })
+            .to_string(),
+        },
+    );
+    call.call_id = "e7-source-call".to_string();
+    let packet = pending_export_for_invocation(&mut call, Vec::new())
+        .await
+        .expect("actual producer export");
+    assert_eq!(
+        packet["facts"]["role_protection"]["value"],
+        json!("model_effort")
+    );
+    assert_eq!(
+        packet["facts"]["role_protection"]["source"],
+        json!("configured-role")
+    );
+    assert_eq!(
+        packet["facts"]["original_model"]["value"],
+        json!("gpt-5-role-override")
+    );
+    assert_eq!(
+        packet["facts"]["original_effort"]["value"],
+        json!("minimal")
+    );
+    assert!(
+        !packet
+            .to_string()
+            .contains("TASK_MUST_NOT_APPEAR_IN_EXPORT")
+    );
+    assert!(
+        !packet
+            .to_string()
+            .contains(&role_path.display().to_string())
+    );
+    tokio::fs::write(&role_path, "model = \"gpt-5-changed-after-hook\"\n")
+        .await
+        .expect("change role fixture");
+    let before_rewrite = Arc::clone(call.pending_spawn.as_ref().expect("captured plan"));
+    let updated_model = call.step_context.settings.model_info.slug.clone();
+    let call = SpawnAgentHandler::default()
+        .with_updated_hook_input(
+            call,
+            json!({
+                "message":"fixture", "agent_type":role_name, "model":updated_model,
+            }),
+        )
+        .expect("actual Hook rewrite retains private plan");
+    let frozen = call
+        .pending_spawn
+        .as_ref()
+        .expect("plan survives registry rewrite");
+    assert!(Arc::ptr_eq(&before_rewrite, frozen));
+    let prepared = prepare_frozen_spawn_config(
+        &call.session,
+        call.step_context.as_ref(),
+        frozen,
+        SpawnConfigOptions {
+            version: SpawnConfigVersion::V1,
+            full_history_fork: false,
+            role_name: Some(&role_name),
+            model: Some(&updated_model),
+            reasoning_effort: None,
+        },
+    )
+    .await
+    .expect("rewritten model preserves captured role after file change");
+    assert_eq!(
+        prepared.config.model.as_deref(),
+        Some("gpt-5-role-override")
+    );
+    println!("MRH_PENDING_EXPORT_JSON={packet}");
+}
