 impl CoreToolRuntime for Handler {
+    fn prepare_pending_delegation<'a>(
+        &'a self,
+        invocation: &'a mut ToolInvocation,
+    ) -> futures::future::BoxFuture<'a, Option<serde_json::Value>> {
+        Box::pin(async move {
+            // Isolated source experiment only; absent by default. Neither tool
+            // input nor MRH settings can supply this host process feature flag.
+            if std::env::var("CODEX_MRH_PENDING_EXPORT_V1").as_deref() != Ok("1") {
+                return None;
+            }
+            let queries = std::env::var("CODEX_MRH_EXPORT_TARGETS")
+                .ok()
+                .filter(|raw| raw.len() <= 1024)
+                .and_then(|raw| serde_json::from_str::<Vec<PendingTargetQuery>>(&raw).ok())
+                .filter(|queries| {
+                    queries.len() <= crate::agent::child_config::MAX_SPAWN_AGENT_MODEL_OVERRIDES
+                })
+                .unwrap_or_default();
+            pending_export_for_invocation(invocation, queries).await
+        })
+    }
+
     fn matches_kind(&self, payload: &ToolPayload) -> bool {
         matches!(payload, ToolPayload::Function { .. })
     }
 }
 
+pub(super) async fn pending_export_for_invocation(
+    invocation: &mut ToolInvocation,
+    queries: Vec<PendingTargetQuery>,
+) -> Option<serde_json::Value> {
+    let arguments = function_arguments(invocation.payload.clone()).ok()?;
+    let args: SpawnAgentArgs = parse_arguments(&arguments).ok()?;
+    if args.model.is_some() {
+        return None;
+    }
+    let role_name = args
+        .agent_type
+        .as_deref()
+        .map(str::trim)
+        .filter(|role| !role.is_empty());
+    let frozen = capture_pending_spawn_config(
+        &invocation.session,
+        invocation.step_context.as_ref(),
+        SpawnConfigOptions {
+            version: SpawnConfigVersion::V1,
+            full_history_fork: args.fork_context,
+            role_name,
+            model: args.model.as_deref(),
+            reasoning_effort: args.reasoning_effort,
+        },
+    )
+    .await
+    .ok()?; // unavailable export; existing Hooks still run on failure
+    let mut export = frozen.routing_export(
+        &invocation.session.session_id().to_string(),
+        &invocation.step_context.turn.sub_id,
+        &invocation.call_id,
+    );
+    // This is a bounded host-process preference query, never a known
+    // declaration from tool_input. Local acceptance is not account availability.
+    if queries.len() <= crate::agent::child_config::MAX_SPAWN_AGENT_MODEL_OVERRIDES {
+        let mut targets = Vec::new();
+        for query in queries {
+            if !safe_export_model(&query.model) {
+                continue;
+            }
+            let resolved = prepare_frozen_spawn_config(
+                &invocation.session,
+                invocation.step_context.as_ref(),
+                &frozen,
+                SpawnConfigOptions {
+                    version: SpawnConfigVersion::V1,
+                    full_history_fork: args.fork_context,
+                    role_name,
+                    model: Some(&query.model),
+                    reasoning_effort: query.reasoning_effort,
+                },
+            )
+            .await;
+            let inherited = prepare_frozen_spawn_config(
+                &invocation.session,
+                invocation.step_context.as_ref(),
+                &frozen,
+                SpawnConfigOptions {
+                    version: SpawnConfigVersion::V1,
+                    full_history_fork: args.fork_context,
+                    role_name,
+                    model: Some(&query.model),
+                    reasoning_effort: None,
+                },
+            )
+            .await;
+            let inherited_known = inherited
+                .as_ref()
+                .is_ok_and(|value| value.config.model.as_deref() == Some(&query.model));
+            let inherited_effort = inherited
+                .ok()
+                .and_then(|value| value.config.model_reasoning_effort);
+            let accepted = resolved
+                .as_ref()
+                .is_ok_and(|value| value.config.model.as_deref() == Some(&query.model));
+            let effort = resolved
+                .ok()
+                .and_then(|value| value.config.model_reasoning_effort);
+            targets.push(serde_json::json!({"model":query.model,
+                "host_accepted":{"known":true,"value":accepted,"source":"actual-spawn-resolver"},
+                "available":{"known":false,"source":"remote-account-unknown"},
+                "efforts":{"known":accepted,"value":if accepted { serde_json::json!([effort]) } else { serde_json::Value::Null },"source":"actual-spawn-resolver"},
+                "inherited_effort":{"known":inherited_known,"value":inherited_effort,"source":"actual-spawn-resolver"}}));
+        }
+        export["targets"] = serde_json::json!(targets);
+    }
+    invocation.pending_spawn = Some(frozen);
+    Some(export)
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct PendingTargetQuery {
+    pub(super) model: String,
+    pub(super) reasoning_effort: Option<ReasoningEffort>,
+}
+
+fn safe_export_model(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 128
+        && value
+            .bytes()
+            .all(|v| v.is_ascii_alphanumeric() || b"_.-".contains(&v))
+        && !["sk-", "bearer", "password", "secret"]
+            .iter()
+            .any(|prefix| value.to_ascii_lowercase().starts_with(prefix))
+}
