+
+/// Private per-invocation plan. No full Config or role contents are exported.
+pub(crate) struct FrozenSpawnConfig {
+    base: Config,
+    role: Option<ResolvedAgentRole>,
+    original: Option<Config>,
+    role_name: Option<String>,
+    version: SpawnConfigVersion,
+    full_history_fork: bool,
+    requested_role: Option<String>,
+    requested_model: Option<String>,
+    requested_effort: Option<ReasoningEffort>,
+}
+
+impl FrozenSpawnConfig {
+    pub(crate) fn matches(&self, options: &SpawnConfigOptions<'_>) -> bool {
+        self.version == options.version
+            && self.full_history_fork == options.full_history_fork
+            && self.requested_role.as_deref() == options.role_name
+    }
+
+    pub(crate) fn routing_export(
+        &self,
+        session: &str,
+        turn: &str,
+        call: &str,
+    ) -> serde_json::Value {
+        let fact = |value: serde_json::Value, source: &str| serde_json::json!({"known":true,"value":value,"source":source});
+        let unknown = serde_json::json!({"known":false,"source":"unavailable"});
+        let protection = self.role.as_ref().map_or(unknown.clone(), |role| {
+            fact(serde_json::json!(role.protection()), role.source)
+        });
+        let original_model = self
+            .original
+            .as_ref()
+            .and_then(|config| config.model.as_ref())
+            .filter(|value| {
+                !value.is_empty()
+                    && value.len() <= 128
+                    && value
+                        .bytes()
+                        .all(|v| v.is_ascii_alphanumeric() || b"_.-".contains(&v))
+                    && !["sk-", "bearer", "password", "secret"]
+                        .iter()
+                        .any(|prefix| value.to_ascii_lowercase().starts_with(prefix))
+            })
+            .map_or(unknown.clone(), |value| {
+                fact(serde_json::json!(value), "resolved-spawn-config")
+            });
+        let original_effort = self.original.as_ref().map_or(unknown, |config| {
+            fact(
+                serde_json::json!(config.model_reasoning_effort),
+                "resolved-spawn-config",
+            )
+        });
+        serde_json::json!({
+            "schema_version":1,"producer_revision":"01fc69f4026735edfdf6789820549727a4867b11",
+            "surface":"native-v1","scope":{"platform":"codex","session_id":session,"turn_id":turn,"tool_call_id":call},
+            "validity":{"kind":"frozen-invocation","nonce":uuid::Uuid::new_v4().to_string(),"expires":"hook-completion"},
+            "facts":{"role_protection":protection,
+                "deny_supported":fact(serde_json::json!(true),"native-pretooluse"),
+                "rewrite_supported":fact(serde_json::json!(true),"native-pretooluse"),
+                "original_model":original_model,
+                "original_effort":original_effort},
+            "targets":[],"target_availability":"unknown-account; no catalog promotion",
+            "effort_semantics":"configured-request-not-provider-execution"
+        })
+    }
+}
+
+/// The export captures role protection independently of an unavailable original
+/// model/effort baseline. This never changes normal Hook error/repair ordering.
+pub(crate) async fn capture_pending_spawn_config(
+    session: &Session,
+    step_context: &StepContext,
+    options: SpawnConfigOptions<'_>,
+) -> Result<Arc<FrozenSpawnConfig>, String> {
+    let base = build_agent_spawn_config(&session.get_base_instructions().await, step_context)?;
+    if options.version == SpawnConfigVersion::V1 && options.full_history_fork {
+        reject_full_fork_agent_type_override(options.role_name)?;
+    }
+    let role = if !options.full_history_fork
+        || (options.version == SpawnConfigVersion::V2 && options.role_name.is_some())
+    {
+        Some(resolve_agent_role(&base, options.role_name).await?)
+    } else {
+        None
+    };
+    let mut frozen = Arc::new(FrozenSpawnConfig {
+        base,
+        role,
+        original: None,
+        role_name: options.role_name.map(str::to_owned),
+        version: options.version,
+        full_history_fork: options.full_history_fork,
+        requested_role: options.role_name.map(str::to_owned),
+        requested_model: options.model.map(str::to_owned),
+        requested_effort: options.reasoning_effort.clone(),
+    });
+    let original = prepare_frozen_spawn_config(session, step_context, &frozen, options)
+        .await
+        .ok()
+        .map(|value| value.config);
+    Arc::get_mut(&mut frozen)
+        .expect("unpublished invocation plan")
+        .original = original;
+    Ok(frozen)
+}
+
+/// Retains the original resolver order with the same parsed role projection.
+/// A role/fork rewrite invalidates the plan and uses the existing fresh path.
+pub(crate) async fn prepare_frozen_spawn_config(
+    session: &Session,
+    step_context: &StepContext,
+    frozen: &Arc<FrozenSpawnConfig>,
+    options: SpawnConfigOptions<'_>,
+) -> Result<PreparedSpawnConfig, String> {
+    if !frozen.matches(&options) {
+        return prepare_agent_spawn_config(session, step_context, options).await;
+    }
+    let config = if let Some(original) = frozen.original.as_ref()
+        && frozen.requested_model.as_deref() == options.model
+        && frozen.requested_effort == options.reasoning_effort
+    {
+        let mut config = original.clone();
+        apply_spawn_agent_service_tier(session, &mut config).await?;
+        apply_spawn_agent_runtime_overrides(&mut config, step_context.turn.as_ref())?;
+        config
+    } else {
+        let mut config = frozen.base.clone();
+        apply_requested_spawn_agent_model_overrides(
+            session,
+            step_context,
+            &mut config,
+            options.model,
+            options.reasoning_effort,
+        )
+        .await?;
+        if let Some(role) = &frozen.role {
+            apply_captured_spawn_role(session, &mut config, role).await?;
+        }
+        apply_spawn_agent_service_tier(session, &mut config).await?;
+        apply_spawn_agent_runtime_overrides(&mut config, step_context.turn.as_ref())?;
+        config
+    };
+    Ok(PreparedSpawnConfig {
+        config,
+        role_name: frozen.role_name.clone(),
+        frozen: Arc::clone(frozen),
+    })
 }
 
