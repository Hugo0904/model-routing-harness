+#[tokio::test]
+async fn pending_delegation_role_projection_preserves_presence_precedence_and_freezes_files() {
+    let (home, mut config) = test_config_with_cli_overrides(Vec::new()).await;
+    let default = resolve_agent_role(&config, None)
+        .await
+        .expect("builtin default");
+    assert_eq!(default.protection(), "unprotected");
+    assert_eq!(default.source, "builtin-role");
+    let path = write_role_config(
+        &home,
+        "same-name.toml",
+        "model_reasoning_effort = \"high\"\n",
+    )
+    .await;
+    config.model_reasoning_effort = Some(ReasoningEffort::High);
+    config.agent_roles.insert(
+        "default".to_string(),
+        crate::config::AgentRoleConfig {
+            description: None,
+            config_file: Some(path.clone()),
+            nickname_candidates: None,
+        },
+    );
+    let projected = resolve_agent_role(&config, None)
+        .await
+        .expect("custom same-name default");
+    assert_eq!(projected.protection(), "effort"); // equal value still protected
+    assert_eq!(projected.source, "configured-role");
+    tokio::fs::write(&path, "model_reasoning_effort = \"low\"\n")
+        .await
+        .expect("update role fixture");
+    projected
+        .apply(&mut config)
+        .expect("frozen typed projection");
+    assert_eq!(config.model_reasoning_effort, Some(ReasoningEffort::High));
+    apply_role_to_config(&mut config, None)
+        .await
+        .expect("fresh invocation recomputes role");
+    assert_eq!(config.model_reasoning_effort, Some(ReasoningEffort::Low));
+}
