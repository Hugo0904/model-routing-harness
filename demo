#!/bin/sh
# Isolated CLI demo: no install, credentials, network, or persistent database.
set -eu
mrh_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for mrh_python in python3.13 python3.12 python3.11 python3; do
    if command -v "$mrh_python" >/dev/null 2>&1 && "$mrh_python" -c 'import sys; raise SystemExit(sys.version_info < (3, 11))' 2>/dev/null; then
        PYTHONPATH="$mrh_root/src${PYTHONPATH:+:$PYTHONPATH}" exec "$mrh_python" -m mrh demo "$@"
    fi
done
printf '%s\n' 'MRH requires Python 3.11 or newer.' >&2
exit 1
