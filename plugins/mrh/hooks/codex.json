{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(spawn_agent|collaborationspawn_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${PLUGIN_ROOT}/scripts/mrh-hook\" codex",
            "timeout": 50
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(spawn_agent|collaborationspawn_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${PLUGIN_ROOT}/scripts/mrh-hook\" codex",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
